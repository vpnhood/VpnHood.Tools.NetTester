<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>nettester</AssemblyName>
		<RootNamespace>VpnHood.Tools.NetTester</RootNamespace>
	</PropertyGroup>

	<!-- Ship as a .NET global/local tool: `dotnet tool install -g VpnHood.Tools.NetTester` -->
	<PropertyGroup>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>nettester</ToolCommandName>
		<PackageId>VpnHood.Tools.NetTester</PackageId>
		<Title>VpnHood NetTester</Title>
		<Description>Network performance testing tool for TCP, HTTP, HTTPS and QUIC. Runs as a server, a client, or both, and measures upload and download throughput across protocols.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="EmbedIO" />
		<PackageReference Include="Microsoft.Native.Quic.MsQuic.OpenSSL" />
		<PackageReference Include="VpnHood.Core.Server.Access" />
		<PackageReference Include="VpnHood.Core.Toolkit" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
	</ItemGroup>

	<!-- Files referenced by the package metadata in Directory.Build.props. -->
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
